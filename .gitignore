# Tuist build cache and generated binaries
Tuist/.build/
Derived/
/Mimic.xcodeproj/
/Mimic.xcworkspace/

# Xcode DerivedData (always local)
DerivedData/

# Graph visualization output
graph.png

# macOS
.DS_Store

# Xcode user data (user-specific IDE state)
*.xcuserstate
xcuserdata/

# SPM build artifacts
.build/
.swiftpm/

# Python cache
__pycache__/
*.pyc

# Local scripted test artifacts
.artifacts/

# Coverage counters dropped by a directly-run test binary
*.profraw

# Generated by the Pathfinder agent commands. Regenerate locally rather than committing: the map is
# a snapshot of the window at one moment, and a stale one describes screens that no longer exist.
.pathfinder/
